# Drip — environment variables. Copy to .env.local (gitignored) for local dev, and set the same in
# Vercel → Project → Settings → Environment Variables. See docs/DEPLOYMENT.md for the full guide.
#
# RULES:
#   - NEXT_PUBLIC_* are shipped to the browser → non-secret values ONLY.
#   - Everything else is server-only (API routes / cron) → NEVER prefix a secret with NEXT_PUBLIC_.
#   - Never commit real values. This file holds placeholders only.

# ── Client-safe (public) ──────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deploy asset + deployed contract addresses (fill after `forge script DeployGame`)
NEXT_PUBLIC_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
NEXT_PUBLIC_NVDA_ADDRESS=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
NEXT_PUBLIC_DRIP_ADDRESS=
NEXT_PUBLIC_GRIDMINE_ADDRESS=
NEXT_PUBLIC_REFINING_ADDRESS=
NEXT_PUBLIC_STAKE_ADDRESS=

# ── Server-only secrets (NO NEXT_PUBLIC_ prefix) ──────────────────────────────
# Neon Postgres — pooled URL for runtime, direct URL for migrations (both sslmode=require).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/drip?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/drip?sslmode=require

# Server RPC (paid/keyed — keep off the client)
RPC_URL=

# Keeper wallet — DEDICATED hot wallet only, minimal gas funds. Server-only. See docs/DEPLOYMENT.md.
KEEPER_PRIVATE_KEY=
# Shared secret the Vercel Cron sends to the keeper route; the route rejects anything else.
CRON_SECRET=
# Slippage floor for the keeper's cut->DRIP/NVDA swaps (wei). 0 = no protection (testnet only).
KEEPER_MIN_OUT=0

# Auth
SESSION_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://your-domain.example/api/auth/x/callback
